<Window x:Class="Win11HotspotManager.BulkTicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu Bilet Üret &amp; Yazdır" Height="620" Width="520"
        MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Adet:" FontSize="13" Foreground="#D4D4D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtBulkCount" Text="10" Width="70" Height="34" VerticalAlignment="Center" Margin="0,0,10,0"
                     Background="#1E1E22" Foreground="#F4F4F5" BorderBrush="#3F3F46" BorderThickness="1" Padding="10,7"/>
            <Button Content="🎟 Biletleri Üret" Height="34" Padding="14,0"
                    Background="#059669" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnBulkGenerate_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock x:Name="TxtBulkInfo" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="4">
            <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto">
                <FlowDocument x:Name="TicketsDoc" PagePadding="24" FontFamily="Consolas, Consolas, Monospace">
                    <Paragraph FontSize="16" FontWeight="Bold" TextAlignment="Center">Wi-Fi Giriş Biletleri</Paragraph>
                    <Paragraph FontSize="11" TextAlignment="Center" Foreground="#555555">Üretmek için yukarıdan adet girip butona basın.</Paragraph>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="🖨 Yazdır" Width="120" Height="36" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnPrint_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="📋 Kopyala" Width="120" Height="36" Margin="0,0,10,0"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand"
                    Click="BtnCopyAll_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Kapat" Width="100" Height="36"
                    Background="Transparent" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
