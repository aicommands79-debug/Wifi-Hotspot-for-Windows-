<Window x:Class="Win11HotspotManager.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR ile Paylaş" Height="620" Width="440"
        MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock x:Name="TxtMainTitle" Text="📷 Wi-Fi Katılım Kodu" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtMainDesc" Text="Telefon kamerasıyla okutun, ağa otomatik katılın." FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,12" TextWrapping="Wrap" TextAlignment="Center"/>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                <Image x:Name="ImgWifiQr" Width="220" Height="220"/>
            </Border>
            <TextBlock x:Name="TxtWifiInfo" FontSize="12" Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,10,0,24" TextAlignment="Center"/>

            <StackPanel x:Name="PanelPortalQr">
                <TextBlock Text="🌐 Giriş Sayfası Kodu" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Wi-Fi'a katıldıktan sonra giriş ekranı açılmazsa bunu okutun." FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,12" TextWrapping="Wrap" TextAlignment="Center"/>
                <Border Background="#FFFFFF" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                    <Image x:Name="ImgPortalQr" Width="180" Height="180"/>
                </Border>
                <TextBlock x:Name="TxtPortalInfo" FontSize="12" Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,10,0,20" TextAlignment="Center"/>
            </StackPanel>

            <Button Content="Kapat" Width="120" Height="36" HorizontalAlignment="Center"
                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
